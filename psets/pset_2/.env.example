# Copia este archivo como .env y completa los valores. El archivo .env NO se sube
# al repositorio (esta en .gitignore). Despues corre:  bash scripts/preparar_env.sh
# para crear .env_encoded, que es como Kestra recibe los secretos.

# --- Snowflake -----------------------------------------------------------------
# Identificador de la cuenta: la parte antes de .snowflakecomputing.com en la URL
# de la cuenta (Snowsight > menu de la cuenta > Account > "Account identifier"),
# con el formato ORGANIZACION-CUENTA, por ejemplo ABCDEFG-XY12345.
SNOWFLAKE_ACCOUNT=ORGANIZACION-CUENTA
SNOWFLAKE_USER=PSET2_SERVICIO
SNOWFLAKE_ROLE=PSET2_ROL
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PORTAFOLIO

# Autenticacion por par de llaves (el usuario de servicio no usa contrasena).
# Ruta local de la llave privada PKCS#8 sin cifrar (la carpeta secrets/ no se sube).
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake_llave.p8
# La llena scripts/preparar_env.sh a partir del archivo anterior: es el cuerpo de la
# llave en una sola linea. No la escribas a mano.
SNOWFLAKE_PRIVATE_KEY=

# --- Parametros del pipeline -----------------------------------------------------
# Corte entre entrenamiento y prueba (sujeto a cambios, igual que en el PSet 1).
# El inicio del historico se elige al correr backfill_historico (input anio_desde).
FECHA_CORTE_ENTRENAMIENTO=2023-12-31

# --- Kestra (solo local) ---------------------------------------------------------
KESTRA_USUARIO=admin@kestra.io
KESTRA_CLAVE=Admin1234
KESTRA_DB_PASSWORD=k3str4

# --- Spark -----------------------------------------------------------------------
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
